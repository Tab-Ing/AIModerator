# Copiar a .env y ajustar. NUNCA versionar el .env real.

# Aplicación
AIMODERATOR_ENV=development
AIMODERATOR_LOG_LEVEL=INFO
AIMODERATOR_HOST=0.0.0.0
AIMODERATOR_PORT=8000

# PostgreSQL (base de datos principal)
# El docker-compose publica el puerto 55432 en el host para no chocar con un
# PostgreSQL local que ya use 5432.
AIMODERATOR_DATABASE_URL=postgresql+psycopg://aimoderator:aimoderator@localhost:55432/aimoderator

# Seguridad
AIMODERATOR_SECRET_KEY=cambiar-por-un-secreto-largo-y-aleatorio
AIMODERATOR_API_KEY_PREFIX=aim_
AIMODERATOR_RATE_LIMIT_PER_MINUTE=120

# Motor de clasificación por defecto y moderación
AIMODERATOR_DEFAULT_ENGINE=heuristic
AIMODERATOR_ENGINE_TIMEOUT_SECONDS=10
AIMODERATOR_MAX_TEXT_LENGTH=5000
AIMODERATOR_STORE_REDACTED_TEXT=false
AIMODERATOR_PI_SHORT_CIRCUIT=true
AIMODERATOR_PI_THRESHOLD=0.5

# Jev AI (System One Model, https://jevai.net)
AIMODERATOR_JEV_ENABLED=false
AIMODERATOR_JEV_BASE_URL=https://api.defapi.org
AIMODERATOR_JEV_MODEL=typesafe/jev-1.13
AIMODERATOR_JEV_API_KEY=

# LLM compatible OpenAI (DeepSeek / OpenAI / ...)
AIMODERATOR_LLM_ENABLED=false
AIMODERATOR_LLM_BASE_URL=https://api.deepseek.com
AIMODERATOR_LLM_MODEL=deepseek-chat
AIMODERATOR_LLM_API_KEY=
